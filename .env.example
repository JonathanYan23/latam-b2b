# =============================================================
# Latam B2B — 环境变量模板
# 复制为 .env 后填写。正式部署（Vercel）在项目设置里填同样的 key。
# =============================================================

# ---------- 数据库 ----------
# 本地开发（SQLite）：
# DATABASE_URL="file:./dev.db"
# 生产（PostgreSQL，如 Supabase/Neon，格式示例）：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---------- NextAuth（认证） ----------
# 正式环境必须换强随机值！生成命令：
#   npx auth secret    （会输出一行类似 AUTH_SECRET=xxx）
# 或 Node: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 本地开发随意，但每次换值都会使已有会话失效：
AUTH_SECRET="replace-with-a-strong-random-secret"

# ---------- 应用 URL ----------
# 本地开发：
# NEXTAUTH_URL="http://localhost:3000"
# 生产：填你的正式域名（如 https://your-domain.com）。
# Vercel 部署时通常可不填（自动推断），若有域名建议显式设置。
NEXTAUTH_URL="http://localhost:3000"

# ---------- 邮件（注册邮箱验证码，Resend https://resend.com） ----------
# 免费 100 封/天。在 resend.com/api-keys 创建 key 后填入。
# 未配置时：本地开发自动降级（验证码直接显示在页面，便于演示）；
# 生产环境未配置则发送失败（注册页提示错误，不会泄露验证码）。
# RESEND_API_KEY="re_xxxxxxxx"
# 发件地址：默认 onboarding@resend.dev（只能发给你的注册邮箱，测试用）；
# 正式上线建议在 Resend 添加并验证域名后改为
# EMAIL_FROM="Latam B2B <no-reply@你的域名>"
